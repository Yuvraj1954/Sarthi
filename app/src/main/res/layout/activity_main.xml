<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg_modern"
    android:padding="24dp"
    android:animateLayoutChanges="true">

    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/settings_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:padding="32dp"
            android:text="Tap mic and speak"
            android:textAlignment="center"
            android:textColor="#334155"
            android:textSize="22sp"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Prompts Card -->
    <TextView
        android:id="@+id/promptsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Try these commands"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:alpha="0.0" 
        app:layout_constraintStart_toStartOf="@id/promptsCard"
        app:layout_constraintTop_toBottomOf="@id/cardView"
        app:layout_constraintBottom_toTopOf="@id/promptsCard"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/promptsCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#F8FAFC"
        app:layout_constraintTop_toBottomOf="@id/promptsLabel"
        app:layout_constraintBottom_toTopOf="@id/micContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">
            
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/promptsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                app:chipSpacing="8dp"
                app:singleLine="false"
                android:animateLayoutChanges="true">
            </com.google.android.material.chip.ChipGroup>
        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/micContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/langToggleGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer Pulse Ring -->
        <View
            android:id="@+id/pulseEffect"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/mic_bg"
            android:layout_gravity="center"
            android:alpha="0.15"/>

        <!-- Main Button -->
        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_mic"
            android:background="@drawable/mic_bg"
            android:layout_gravity="center"
            android:contentDescription="Microphone"
            android:elevation="12dp"
            android:scaleType="centerInside"/>
            
    </FrameLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/langToggleGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnHindi"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHindi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hindi"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textSize="18sp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textColor="@color/toggle_text_color"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnglish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="English"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textSize="18sp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textColor="@color/toggle_text_color"/>

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/footerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Made with ❤️ by Yuvraj"
        android:textSize="12sp"
        android:textColor="#64748B"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
